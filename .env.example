# Copy this file to `.env.local` (that file is git-ignored) and fill in the two values.
# Supabase dashboard → Project Settings → API:
#   Project URL  →  VITE_SUPABASE_URL
#   anon / publishable key  →  VITE_SUPABASE_ANON_KEY   (this key is meant to be public; never use the "service_role" key here)
#
# Leave them empty and the site falls back to saving in your own browser only.
# When you deploy (Vercel, Netlify, …), add the same two variables in the host's settings.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
